SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
SP_API_MARKETPLACE_ID=A1F83G8C2ARO7P

# SignMaster 101 UK Road Sign Flashcards — production ASIN (set in Vercel Production).
# Used by activation verify, order sync filter, and SP-API config (getSpApiConfig / getActivationTargetAsin).
# Local Vitest/order-filter fixtures may use other synthetic ASINs; they do not read this file.
TARGET_ASIN=B0H8ZRL6DK

# Local Supabase (npx supabase start). Used by npm run dev:full and server scripts.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Browser-safe Supabase Auth (Vite bundle — anon key only).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional — local Supabase OAuth (CP9 manual testing only). Not required for `npx supabase start`.
#
# IMPORTANT: `npm run dev:full` reads `.env.local`, but `npx supabase start` does NOT. The CLI resolves
# config.toml env(...) from a project-root `.env` file and/or your shell environment only.
# If these are missing, GoTrue sends the literal string `env(SUPABASE_AUTH_EXTERNAL_...)` to Google/Apple
# and you will see Google `401 invalid_client` / Apple `403`.
#
# Setup (pick one):
#   A) Add the four variables below to `.env.local` (for the app) AND duplicate them into project-root `.env`
#   B) `ln -sf .env.local .env` so one file satisfies both (gitignored)
#   C) `export` all four before `npx supabase start`
#
# After any change: `npx supabase stop` && `npx supabase start`, then verify authorize URLs use a real
# client id (not `env(...)`). Google OAuth Web client redirect URI must be exactly:
#   http://127.0.0.1:54321/auth/v1/callback
# App origins in Google Console: http://localhost:4200 and http://127.0.0.1:4200
#
# Google `secret`: OAuth client secret. Apple `secret`: Sign in with Apple client secret (JWT from .p8 key).
# Apple web Sign in usually requires HTTPS return URLs; local callback is plain HTTP — see README local OAuth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
